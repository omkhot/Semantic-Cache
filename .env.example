# Copy this file to ".env" and fill in your key:   cp .env.example .env
# Never commit .env (it is already in .gitignore).

# ---- LLM -------------------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=paste-your-key-here
# Run `python -m scripts.check_gemini` to list the models your key can use.
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_OUTPUT_TOKENS=1024

# ---- Embeddings ------------------------------------------------------------
# minilm = local sentence-transformers model (recommended, free, no key)
# gemini = Gemini embedding API   |   hash = offline toy embedder (tests only)
EMBEDDER=minilm
EMBEDDER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Cache behaviour -------------------------------------------------------
# exact | semantic | semantic+verify
CACHE_MODE=semantic+verify
# Cosine similarity needed before a cached answer is even considered.
# Tune it with:  python -m evaluation.run_eval   (it prints a recommendation)
SIMILARITY_THRESHOLD=0.85
# none | rules | cross | rules+cross   ("cross" downloads one more small model)
VERIFIER=rules
TTL_SECONDS=86400
MAX_ENTRIES=10000
PERSIST_DIR=data/cache_store

# ---- Notional prices (USD per 1M tokens) for the "money saved" metric --------
# Placeholders. Put your model's real prices; on the free tier real cost is $0.
PRICE_IN_PER_M=0.30
PRICE_OUT_PER_M=2.50
